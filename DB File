class DBConnection {
    private static final String URL = "jdbc:sqlite:library.db";

    public static Connection connect() {
        try {
            return DriverManager.getConnection(URL);
        } catch (SQLException e) {
            System.out.println("Connection failed: " + e.getMessage());
            return null;
        }
    }
}
class DBSetup { 
	public static void initialize() { 
		
		String books = """
	            CREATE TABLE IF NOT EXISTS books (
	                id INTEGER PRIMARY KEY AUTOINCREMENT,
	                title TEXT,
	                author TEXT,
	                publisher TEXT,
	                year INTEGER,
	                genre TEXT,
	                available INTEGER
	            );
	        """;

	        String members = """
	            CREATE TABLE IF NOT EXISTS members (
	                id INTEGER PRIMARY KEY AUTOINCREMENT,
	                name TEXT,
	                card TEXT,
	                email TEXT,
	                password TEXT,
	                active INTEGER
	            );
	        """;

	        try (Connection conn = DBConnection.connect();
	             Statement stmt = conn.createStatement()) {

	            stmt.execute(books);
	            stmt.execute(members);

	        } catch (SQLException e) {
	            e.printStackTrace();
	        }
		
	}
}


//BOOK CLASS
class Book {
	int book_id;
	String title;
	Author author;
	String publisher;
	int year;
	boolean available = true;
	boolean activated = true;
	String genre;
	Member borrowedBy = null;
	
	Book(int book_id, String title, Author author, String publisher, int year, String genre) {
		this.book_id = book_id;
		this.title = title;
		this.author = author;
		this.publisher = publisher;
		this.year = year;
		this.genre = genre;
	}
		
}

//MEMBER CLASS
class Member {
	int member_id;
	String member_name;
	String lib_card_num;
	String email;
	String password;
	boolean active_status = true;
	
	Member(int member_id, String member_name, String lib_card_num, String email, String password) {
		this.member_id = member_id;
		this.member_name = member_name;
		this.lib_card_num = lib_card_num;
		this.email = email;
		this.password = password;
	}
}

//AUTHOR CLASS
class Author {
	int author_id;
	String author_name;
	String country;
	ArrayList<Book> books_written = new ArrayList<>();
	
	Author(int author_id, String author_name, String country) {
		this.author_id = author_id;
		this.author_name = author_name;
		this.country = country;
	}
}

