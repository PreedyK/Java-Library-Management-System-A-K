package comHamann;
import java.util.Scanner;
import java.util.ArrayList;

//BOOK CLASS
class Book {
	int book_id;
	String title;
	Author author;
	String publisher;
	int year;
	boolean available = true;
	boolean activated = true;
	String genre;
	Member borrowedBy = null;
	
	Book(int book_id, String title, Author author, String publisher, int year, String genre) {
		this.book_id = book_id;
		this.title = title;
		this.author = author;
		this.publisher = publisher;
		this.year = year;
		this.genre = genre;
	}
		
}

//MEMBER CLASS
class Member {
	int member_id;
	String member_name;
	String lib_card_num;
	String email;
	String password;
	boolean active_status = true;
	
	Member(int member_id, String member_name, String lib_card_num, String email, String password) {
		this.member_id = member_id;
		this.member_name = member_name;
		this.lib_card_num = lib_card_num;
		this.email = email;
		this.password = password;
	}
}

//AUTHOR CLASS
class Author {
	int author_id;
	String author_name;
	String country;
	ArrayList<Book> books_written = new ArrayList<>();
	
	Author(int author_id, String author_name, String country) {
		this.author_id = author_id;
		this.author_name = author_name;
		this.country = country;
	}
}

//AUTHOR CLASS
class Admin {
	int admin_id;
	String admin_name;
	String position;
	String password;
	String email;
	
	Admin(int admin_id, String admin_name, String position, String password, String email){
		this.admin_id = admin_id;
		this.admin_name = admin_name;
		this.position = position;
		this.password = password;
		this.email = email;
	}
}

//LIBRARY CLASS
class Library {
	ArrayList<Book> books = new ArrayList<>();
	ArrayList<Member> members = new ArrayList<>();
	ArrayList<Admin> admins = new ArrayList<>();
	ArrayList<Author> authors = new ArrayList<>();
	
	//create admin
	int nextAdminid = 1;
	Admin createAdmin(String name, String position, String password, String email) {
		Admin a = new Admin(nextAdminid++, name, position, password, email);
		admins.add(a);
		return a;
	}
	
	//admin login
	Admin authenticateAdmin(String current_email, String current_password) {
		for (Admin a:admins) {
			if (a.email.equals(current_email)) {
				if (a.password.equals(current_password)) {
					return a;
				}
			}
		}
		return null;
	}
	
	//member login
	Member memberLogin(String email, String password) {
		for (Member m: members) {
			if (m.email.equals(email) && m.password.equals(password)) {
				return m;
			}
		}
		return null;
	}
	
	//create member
    int nextMemberId = 1;
    Member createMember(String name, String cardNum, String email, String password) {
        Member m = new Member(nextMemberId++, name, cardNum, email, password);
        members.add(m);
        return m;
    }
    
    //deactivate member
    Member deactivateMember(String name) {
    	for (Member m : members) {
            if (m.member_name.equalsIgnoreCase(name)) {
            	if (m.active_status) {
            		m.active_status = false;
            		return m;
            	}
            	else {
            		System.out.println("Error: This member is already inactive");
            		return null;
            	}
            }
        }
    	System.out.println("Error: Member not found");
        return null;
    	
    }
    
    //display members
    void displayMembers() {
        for (Member m : members) {
        	String status = m.active_status ? "Active" : "Inactive";
            System.out.println(m.member_id + ": " + m.member_name + ". Card number: " + m.lib_card_num + ". Email: " + m.email + ". Password: " + m.password + " [" + status + "]");
        }
    }
	 
	//create author
	int nextAuthorId = 1;
    Author getOrCreateAuthor(String name, String country) {
        // Look for existing author
        for (Author a : authors) {
            if (a.author_name.equalsIgnoreCase(name)) {
                return a;
            }
        }
        // Not found → create new
        Author newAuthor = new Author(nextAuthorId++, name, country);
        authors.add(newAuthor);
        return newAuthor;
    }
    
    //create book
	int nextBookId = 1;
    Book createBook(String title, String authorName, String author_country, String publisher, int year, String description) {
    	Author authorob = getOrCreateAuthor(authorName, author_country);
        Book b = new Book(nextBookId++, title, authorob, publisher, year, description);
        books.add(b);
        authorob.books_written.add(b);
        return b;
    }
    
    //display books
    void displayBooks() {
        for (Book b : books) {
        	String status = b.available ? "Available" : "Borrowed";
            System.out.println(b.book_id + "(" + b.genre + "): " + b.title + " by " + b.author.author_name + ", published by " + b.publisher + " in " + b.year + " [" + status + "]");
        }
    }
    
    //borrow a book
    boolean borrowBook(int bookId, Member member) {
        if (member.active_status == true) {
    	for (Book b : books) {
            if (b.book_id == bookId && b.available) {
                b.available = false;
                b.borrowedBy = member;
                return true;
            }
        }
        }
        return false;
    }
    
    //return a book
    boolean returnBook(int bookId, Member member) {
        for (Book b : books) {
            if (b.book_id == bookId && b.borrowedBy == member) {
                b.available = true;
                b.borrowedBy = null;
                return true;
            }
        }
        return false;
 }
    //display books borrowed by member who is logged in
    void displayBorrowedBooks(Member member) {
        System.out.println(member.member_name + "'s borrowed books:");
        for (Book b : books) {
            if (b.borrowedBy == member) {
                System.out.println(b.book_id + ": " + b.title + " by " + b.author.author_name);
            }
        }
    }
    
    //display authors
    void displayAuthors() {
        for (Author a : authors) {
        	System.out.println(a.author_id + ": " + a.author_name + " (" + a.country + ")");
            
        }
    }
    
    void displayBooksByAuthor(int authorId) {
        for (Author a : authors) {
            if (a.author_id == authorId) {
                System.out.println("Books by " + a.author_name + ":");
                
                for (Book b : a.books_written) {
                    String status = b.available ? "Available" : "Borrowed";
                    System.out.println(b.book_id + ": " + b.title + " [" + status + "]");
                }
                return;
            }
        }
        System.out.println("Author not found.");
    }

}

//MAIN CLASS
public class LibManSystem {
	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
        Library library = new Library();

        // Add some initial books, members, and admin for testing
        library.createBook("1984", "George Orwell", "UK", "Secker", 1949, "Dystopian");
        library.createBook("Animal Farm", "George Orwell", "UK", "Secker", 1945, "Political allegory");
        library.createMember("Abby", "12345", "abby@email.com", "pass");
        library.createAdmin("Admin", "Librarian", "admin123", "admin@library.com");

        System.out.println("=== Welcome to the Library Management System ===");

        while (true) {
            System.out.println("\n1. Login");
            System.out.println("2. Exit");
            System.out.print("Choice: ");
            int mainChoice = scanner.nextInt();
            scanner.nextLine(); // clear buffer

            if (mainChoice == 1) {
                System.out.print("Enter email: ");
                String email = scanner.nextLine();
                System.out.print("Enter password: ");
                String password = scanner.nextLine();

                // Try admin login first
                Admin admin = library.authenticateAdmin(email, password);
                if (admin != null) {
                    runAdminMenu(scanner, library, admin);
                } else {
                    // Try member login
                    Member member = library.memberLogin(email, password);
                    if (member != null) {
                        runMemberMenu(scanner, library, member);
                    } else {
                        System.out.println("Invalid login. Try again.");
                    }
                }
            } else {
                System.out.println("Goodbye!");
                break;
            }
        }

        scanner.close();
    }

    // Admin menu
    static void runAdminMenu(Scanner scanner, Library library, Admin admin) {
        System.out.println("Welcome Admin " + admin.admin_name);
        while (true) {
            System.out.println("\n--- Admin Menu ---");
            System.out.println("1. Add Book");
            System.out.println("2. View Books");
            System.out.println("3. Add Member");
            System.out.println("4. View Members");
            System.out.println("5. View Authors");
            System.out.println("6. View Books by Author");
            System.out.println("7. Deactivate Member");
            System.out.println("8. Exit");
            System.out.print("Choice: ");
            int choice = scanner.nextInt();
            scanner.nextLine(); // clear buffer

            if (choice == 1) {
                System.out.print("Title: ");
                String title = scanner.nextLine();
                System.out.print("Author Name: ");
                String authorName = scanner.nextLine();
                System.out.print("Author Country: ");
                String authorCountry = scanner.nextLine();
                System.out.print("Publisher: ");
                String publisher = scanner.nextLine();
                System.out.print("Year: ");
                int year = scanner.nextInt();
                scanner.nextLine(); // clear buffer
                System.out.print("Genre: ");
                String description = scanner.nextLine();

                library.createBook(title, authorName, authorCountry, publisher, year, description);
                System.out.println("Book added successfully!");

            } else if (choice == 2) {
                library.displayBooks();

            } else if (choice == 3) {
                System.out.print("Name: ");
                String name = scanner.nextLine();
                System.out.print("Library Card Number: ");
                String cardNum = scanner.nextLine();
                System.out.print("Email: ");
                String memEmail = scanner.nextLine();
                System.out.print("Password: ");
                String memPassword = scanner.nextLine();

                library.createMember(name, cardNum, memEmail, memPassword);
                System.out.println("Member added successfully!");

            } else if (choice == 4) {
            	library.displayMembers();
            	
            } else if (choice == 5) {
            	library.displayAuthors();
            	
            } else if (choice == 6) {
                library.displayAuthors();
                System.out.print("Enter author ID: ");
                int id = scanner.nextInt();
                scanner.nextLine();

                library.displayBooksByAuthor(id);
                
            } else if (choice == 7) {
            	System.out.print("Enter member name");
            	String memName = scanner.nextLine();
            	library.deactivateMember(memName);
            	
            } else if (choice == 8) {
                System.out.println("Exiting admin menu.");
                break;
                
            } else {
                System.out.println("Invalid choice. Try again.");
            }
        }
    }

    // Member menu
    static void runMemberMenu(Scanner scanner, Library library, Member member) {
        System.out.println("Welcome " + member.member_name);
        while (true) {
            System.out.println("\n--- Member Menu ---");
            System.out.println("1. View Books");
            System.out.println("2. Borrow Book");
            System.out.println("3. Return Book");
            System.out.println("4. My Borrowed Books");
            System.out.println("5. View Authors");
            System.out.println("6. View Books by Author");
            System.out.println("7. Exit");
            System.out.print("Choice: ");
            int choice = scanner.nextInt();
            scanner.nextLine(); // clear buffer

            if (choice == 1) {
                library.displayBooks();

            } else if (choice == 2) {
                System.out.print("Enter book ID to borrow: ");
                int id = scanner.nextInt();
                scanner.nextLine();

                if (library.borrowBook(id, member)) {
                    System.out.println("Book borrowed!");
                } else {
                    System.out.println("Book not available.");
                }

            } else if (choice == 3) {
                System.out.print("Enter book ID to return: ");
                int id = scanner.nextInt();
                scanner.nextLine();

                if (library.returnBook(id, member)) {
                    System.out.println("Book returned!");
                } else {
                    System.out.println("You can't return this book.");
                }

            } else if (choice == 4) {
                library.displayBorrowedBooks(member);

            } else if (choice == 5) {
            	library.displayAuthors();
            	
            }else if (choice == 6) {
                library.displayAuthors();
                System.out.print("Enter author ID: ");
                int id = scanner.nextInt();
                scanner.nextLine();

                library.displayBooksByAuthor(id);
            } else if (choice == 7) {
                System.out.println("Exiting member menu.");
                break;

            } else {
                System.out.println("Invalid choice. Try again.");
            }
        }
	}
}
