class DBConnection {
    private static final String URL = "jdbc:sqlite:library.db";

    public static Connection connect() {
        try {
        	Class.forName("org.sqlite.JDBC");
            return DriverManager.getConnection(URL);
        } catch (Exception e) {
            System.out.println("Connection failed: " + e.getMessage());
            return null;
        }
    }
}
class DBSetup { 
	public static void initialize() { 
		
		String books = """
	            CREATE TABLE IF NOT EXISTS books (
	                id INTEGER PRIMARY KEY AUTOINCREMENT,
	                title TEXT,
	                author TEXT,
	                publisher TEXT,
	                year INTEGER,
	                genre TEXT,
	                available INTEGER,
	                borrowed_by INTEGER
	            );
	        """;

	        String members = """
	            CREATE TABLE IF NOT EXISTS members (
	                id INTEGER PRIMARY KEY AUTOINCREMENT,
	                name TEXT,
	                card TEXT,
	                email TEXT,
	                password TEXT,
	                active INTEGER
	            );
	        """;

	        try (Connection conn = DBConnection.connect();
	        	     Statement stmt = conn.createStatement()) {

	        	    stmt.execute(books);
	        	    stmt.execute(members);

	        	    // check if column exists before adding it
	        	    ResultSet rs = stmt.executeQuery("PRAGMA table_info(books)");

	        	    boolean hasBorrowedBy = false;

	        	    while (rs.next()) {
	        	        if (rs.getString("name").equals("borrowed_by")) {
	        	            hasBorrowedBy = true;
	        	            break;
	        	        }
	        	    }

	        	    if (!hasBorrowedBy) {
	        	        stmt.execute("ALTER TABLE books ADD COLUMN borrowed_by INTEGER");
	        	    }
	        	    
	        	    // check if 'activated' column exists
	        	    ResultSet rs2 = stmt.executeQuery("PRAGMA table_info(books)");

	        	    boolean hasActivated = false;

	        	    while (rs2.next()) {
	        	        if (rs2.getString("name").equals("activated")) {
	        	            hasActivated = true;
	        	            break;
	        	        }
	        	    }

	        	    if (!hasActivated) {
	        	        stmt.execute("ALTER TABLE books ADD COLUMN activated INTEGER DEFAULT 1");
	        	    }

	        	} catch (SQLException e) {
	        	    e.printStackTrace();
	        	}
		
	}
}

//BOOK CLASS
class Book {
	int book_id;
	String title;
	Author author;
	String publisher;
	int year;
	boolean available = true;
	boolean activated = true;
	String genre;
	Member borrowedBy = null;
	
	Book(int book_id, String title, Author author, String publisher, int year, String genre) {
		this.book_id = book_id;
		this.title = title;
		this.author = author;
		this.publisher = publisher;
		this.year = year;
		this.genre = genre;
	}
		
}

//MEMBER CLASS
